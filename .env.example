# --- App ---
APP_ENV=local
APP_NAME=ai-template
LOG_LEVEL=INFO

# --- Postgres (usado pelo container db) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Rodando a API local (fora do docker): host = localhost
# Dentro do docker compose o host é sobrescrito para "db"
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# USD por 1M tokens, para estimar o custo no log (0 = não calcula)
GEMINI_INPUT_PRICE_PER_MTOK=0
GEMINI_OUTPUT_PRICE_PER_MTOK=0

# --- API externa ---
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com
HTTP_TIMEOUT_SECONDS=10

# --- Health ---
HEALTH_CHECK_TIMEOUT_SECONDS=3
